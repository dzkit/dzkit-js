{
  "name": "@dzkit/dzkit-js",
  "version": "0.1.0",
  "description": "Algerian developer toolkit: CCP/RIP keys, NIF/NIS, phone numbers, licence plates (69 wilayas), DZD amounts in words (French & Arabic), IRG/CNAS payroll.",
  "keywords": [
    "algeria",
    "algerie",
    "dz",
    "ccp",
    "rip",
    "nif",
    "nis",
    "irg",
    "cnas",
    "payroll",
    "wilaya",
    "dinar",
    "montant en lettres",
    "validator"
  ],
  "license": "MIT",
  "author": "Siroukane (https://github.com/DrSiroukane)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzkit/dzkit-js.git"
  },
  "homepage": "https://github.com/dzkit/dzkit-js#readme",
  "bugs": "https://github.com/dzkit/dzkit-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "npm run build && node scripts/build-demo.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
